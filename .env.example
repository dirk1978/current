# Copy to .env (or run ./setup.sh, which writes it for you). Everything except ACCESS_TOKEN is optional:
# with nothing else set you get the national grid screens only.

# Long random secret. The app and browser must send it to see any data. Generate one with:
#   openssl rand -base64 24
ACCESS_TOKEN=

# Port the server listens on (plain HTTP; put a reverse proxy with TLS in front for internet access)
PORT=8092

# Octopus Energy: API key from https://octopus.energy/dashboard/new/accounts/personal-details/api-access
OCTOPUS_API_KEY=
# Optional: found from the key if left empty (set it if your key sees more than one account)
OCTOPUS_ACCOUNT=
# Optional: SMETS1 gas meters report kWh rather than m³; set to kWh if your gas figures look ~11x too high
OCTOPUS_GAS_UNITS=

# Ohme charger (unofficial API, your normal Ohme app login). Quote the password if it has special characters.
OHME_EMAIL=
OHME_PASSWORD=

# Colour of the car drawn on the Car screen, e.g. #2f4a6d (optional)
CAR_COLOUR=

# Usable battery in kWh, for turning the car's battery % into energy (optional; otherwise Ohme's figure)
CAR_USABLE_KWH=

# CUPRA (MyCUPRA app login; unofficial API, the one the app uses): range, mileage, climate, locks, trips, pictures
CUPRA_EMAIL=
CUPRA_PASSWORD=
# 4-digit S-PIN from the MyCUPRA app, only needed for remote controls that ask for it
CUPRA_SPIN=

# Android app build (android/build.sh)
# Where the app finds your server: internet address first, then an optional LAN fallback
PUBLIC_URL=
LAN_URL=
# Android application id (change it if you publish your own build)
APP_ID=
# Generated on the first build; keep it, updates only install over an app signed with the same key
ANDROID_KEYSTORE_PASSWORD=
# Docker image with the Android SDK (built from android/Dockerfile if missing)
ANDROID_BUILD_IMAGE=

# Screenshots (tools/shot.mjs): a folder whose node_modules has Playwright, if not installed here
PLAYWRIGHT_DIR=
